{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tmdb-embed-api",
  "main": "./cloudflare-worker.js",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["TMDB_API_KEY"]
  },
  "containers": [
    {
      "class_name": "TMDBEmbedContainer",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TMDBEmbedContainer"]
    }
  ]
}
